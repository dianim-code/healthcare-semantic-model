/// Resident population on 1 January, by year and region (ISTAT).
table fact_population
	lineageTag: 280de650-63c9-4af8-9e25-32dc0139a439

	/// Reference year (population on 1 January).
	column year
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6b76f4d2-21cb-4024-8dd4-e3fd9245b55e
		summarizeBy: none
		sourceColumn: year

	/// Region or autonomous province.
	column region_code
		dataType: string
		isHidden
		lineageTag: 841e33a9-b5ac-45f5-9efe-9b9677a640b5
		summarizeBy: none
		sourceColumn: region_code

	/// Total resident population (both sexes, all ages).
	column population
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: ba3238a3-86a1-41d0-a442-26bb2bc5f9f1
		summarizeBy: none
		sourceColumn: population

	partition fact_population = m
		mode: import
		source =
				let
				    Source = GoldTable("fact_population"),
				    Typed = Table.TransformColumnTypes(Source, {{"year", Int64.Type}, {"region_code", type text}, {"population", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

